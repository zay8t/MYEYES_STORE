// MY EYES — Prisma Schema
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  OPTICIAN
  ADMIN
  SUPER_ADMIN
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  EASYPAISA
  JAZZCASH
  RAAST
}

enum FrameShape {
  NILL
  WAYFARER
  AVIATOR
  RECTANGLE
  ROUND
  OVAL
  SQUARE
  CAT_EYE
  GEOMETRIC
  RIMLESS
  SEMI_RIMLESS
}

enum Material {
  NILL
  ACETATE
  METAL
  TITANIUM
  TR90
  STAINLESS_STEEL
  WOOD
  HYBRID
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  ORDER_PLACED
  ADVANCE_PENDING
  ADVANCE_VERIFIED
  LAB_QUEUED
  LENS_SURFACING_EDGING
  QUALITY_INSPECTION_PASSED
  DISPATCHED_WITH_COURIER
  CANCELLED
}

enum Category {
  NILL
  EYEGLASSES
  SUNGLASSES
  CONTACT_LENSES
  ACCESSORIES
}

// ─────────────────────────────────────────────────────────────────────────────
// Customer & Account Models
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id             String  @id @default(cuid())
  name           String
  email          String  @unique
  phone          String? @unique
  passwordHash   String
  role           Role    @default(CUSTOMER)
  avatarUrl      String?
  savedFaceShape String? // "OVAL", "SQUARE", "ROUND", "HEART", "DIAMOND"
  isVerified     Boolean @default(false)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relational nodes
  cartItems     CartItem[]
  wishlist      WishlistItem[]
  prescriptions SavedPrescription[]
  orders        Order[]             @relation("UserOrders")
  addresses     Address[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model CartItem {
  id               String  @id @default(cuid())
  userId           String
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  quantity         Int     @default(1)
  selectedColor    String?
  lensPackageId    String? // "cr-crystal", "blue-defense", "sun-adaptive", "ultra-thin-167"
  prescriptionData Json?   // { odSph, odCyl, odAxis, osSph, osCyl, osAxis, pd, addPower, lensType }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, lensPackageId])
  @@index([userId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model SavedPrescription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String  @default("My Everyday Prescription")
  isDefault Boolean @default(false)

  // Right Eye (OD)
  odSph Decimal? @db.Decimal(4, 2)
  odCyl Decimal? @db.Decimal(4, 2)
  odAxis Int?

  // Left Eye (OS)
  osSph Decimal? @db.Decimal(4, 2)
  osCyl Decimal? @db.Decimal(4, 2)
  osAxis Int?

  pd               Decimal? @db.Decimal(4, 1)
  addPower         Decimal? @db.Decimal(4, 2)
  prescriptionType String   @default("SINGLE_VISION") // "SINGLE_VISION", "PROGRESSIVE", "BIFOCAL"
  slipImageUrl     String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_prescriptions")
}

model Address {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phoneNumber   String
  streetAddress String
  city          String
  province      String
  postalCode    String?
  isDefault     Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────────────────────────────────────────────────────
// Product & Order Models (Existing, Preserved)
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String
  price       Float
  stock       Int        @default(0)
  frameShape  FrameShape @default(NILL)
  material    Material   @default(NILL)
  gender      String     @default("unisex")
  colors      String[]   @default([])
  images      String
  category    Category   @default(EYEGLASSES)
  featured    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       OrderItem[]
  image_url           String?
  image_public_id     String?
  modelGlbUrl         String?
}

model Order {
  id                  String        @id @default(uuid())
  orderNumber         String?       @unique
  customerName        String
  customerEmail       String
  customerPhone       String?
  shippingAddress     String?
  shippingCity        String?
  paymentMethod       PaymentMethod @default(BANK_TRANSFER)
  paymentStatus       PaymentStatus @default(PENDING_VERIFICATION)
  paymentReceiptUrl   String?
  transactionProofUrl String?
  shippingFee         Float?        @default(250)
  stripeSessionId     String?
  totalAmount         Float
  currency            String        @default("PKR")
  status              OrderStatus   @default(PROCESSING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  items               OrderItem[]

  // Optional link to registered User
  userId String?
  user   User?   @relation("UserOrders", fields: [userId], references: [id], onDelete: SetNull)

  // ── Payment Verification Fields ──────────────────────────────────
  transactionId      String?  @unique
  paymentSenderName  String?
  paymentSenderPhone String?
  ocrExtractedTid    String?
  ocrConfidenceScore Float?
  isOcrMatched       Boolean  @default(false)
  flaggedSuspicious  Boolean  @default(false)

  // ── Admin Audit Trail ─────────────────────────────────────────────
  verifiedBy       String?
  verifiedAt       DateTime?
  rejectionReason  String?
  customerNotified Boolean         @default(false)
  auditLogs        PaymentAuditLog[]

  @@index([userId])
}

model PaymentAuditLog {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action    String   // SUBMITTED | OCR_PARSED | APPROVED | REJECTED | FLAGGED | NOTIFIED
  actor     String   // CUSTOMER | SYSTEM_OCR | ADMIN
  notes     String?
  createdAt DateTime @default(now())
}

model LensOption {
  id                    String   @id @default(uuid())
  name                  String
  description           String
  price                 Float
  pricePlus40           Float    @default(0)
  type                  String
  index                 String?
  isConfiguratorVisible Boolean  @default(true)
  createdAt             DateTime @default(now())
}

model OrderSequence {
  id        Int      @id @default(1)
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  productId      String
  prescriptionId String?
  price          Float
  quantity       Int     @default(1)

  framePrice         Float?
  lensBasePriceKey   String?
  lensBasePriceValue Float?
  lensMultiplier     Float?
  lensFinalPrice     Float?

  isAsymmetricRx    Boolean? @default(false)
  rightEyeLensPrice Float?
  leftEyeLensPrice  Float?
  rightMultiplier   Float?
  leftMultiplier    Float?

  selectedLensName    String?
  calculatedLensPrice Float?
  totalAmount         Float?

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id])
}

model Prescription {
  id        String      @id @default(uuid())
  lensType  String
  odSph     Float
  odCyl     Float?
  odAxis    Int?
  osSph     Float
  osCyl     Float?
  osAxis    Int?
  pd        Float
  fileUrl   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt @default(now())
  OrderItem OrderItem[]
  prescription_url       String?
  prescription_public_id String?
}

model LensPrice {
  id          String   @id @default(uuid())
  category    String   // "SINGLE_VISION", "BIFOCAL", "PROGRESSIVE"
  name        String   // "Anti-Glare Standard", "Blue Light Shield", "Photogray Transition"
  price       Float
  pricePlus40 Float    @default(0)
  description String?
  index       String?  // "1.56", "1.61", "1.67"
  isPopular   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  age       Int      @default(0)
  whatsapp  String
  frameId   String?
  frameName String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model BasePriceSetting {
  key       String   @id
  value     Float
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Discount Engine — Promo Code & Announcement Banner
// ─────────────────────────────────────────────────────────────────────────────

model DiscountCode {
  id    String @id @default(uuid())
  code  String @unique // normalized UPPERCASE

  title  String // e.g. "Holiday Sale"
  type   String // "percentage" | "fixed_cart"
  amount Float  // 20 for 20% or 500 for Rs. 500

  minCartTotal     Float @default(0)    // minimum cart subtotal
  maxDiscountLimit Float?               // PKR ceiling for percentage discounts

  usageLimitTotal Int? // null = unlimited
  timesUsed       Int  @default(0)

  startsAt DateTime
  endsAt   DateTime?

  isActive Boolean @default(true)

  // Announcement Banner Controls
  showAnnouncementBanner Boolean @default(false)
  bannerText             String  @default("")
  bannerTheme            String  @default("dark") // "dark" | "amber" | "emerald" | "crimson"

  // Promotional Catalog Badge Controls
  showProductBadge Boolean @default(true)
  badgeLabel       String  @default("") // e.g. "20% OFF", "SALE", or auto-derived
  badgeType        String  @default("percentage") // "percentage" | "fixed_cart" | "custom"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("discount_codes")
}

