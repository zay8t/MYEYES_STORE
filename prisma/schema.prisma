// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FrameShape {
  NILL
  WAYFARER
  AVIATOR
  RECTANGLE
  ROUND
  OVAL
  SQUARE
  CAT_EYE
  GEOMETRIC
  RIMLESS
  SEMI_RIMLESS
}

enum Material {
  NILL
  ACETATE
  METAL
  TITANIUM
  TR90
  STAINLESS_STEEL
  WOOD
  HYBRID
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
}

enum Category {
  NILL
  EYEGLASSES
  SUNGLASSES
  CONTACT_LENSES
  ACCESSORIES
}

model Product {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String
  price       Float
  stock       Int        @default(0)
  frameShape  FrameShape @default(NILL)
  material    Material   @default(NILL)
  gender      String     @default("unisex")
  colors      String[]   @default([])
  images      String
  category    Category   @default(EYEGLASSES)
  featured    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       OrderItem[]
  image_url   String?
  image_public_id String?
}

model Order {
  id                  String      @id @default(uuid())
  orderNumber         String?     @unique
  customerName        String
  customerEmail       String
  customerPhone       String?
  shippingAddress     String?
  shippingCity        String?
  paymentMethod       String?
  paymentStatus       String      @default("PENDING")
  paymentReceiptUrl   String?
  transactionProofUrl String?
  shippingFee         Float?      @default(250)
  stripeSessionId     String?
  totalAmount         Float
  currency            String      @default("PKR")
  status              OrderStatus @default(PENDING)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  items               OrderItem[]

  // ── Payment Verification Fields ──────────────────────────────────
  transactionId        String?  @unique        // Unique → prevents duplicate TID fraud
  paymentSenderName    String?
  paymentSenderPhone   String?
  ocrExtractedTid      String?                 // TID extracted by OCR parser
  ocrConfidenceScore   Float?                  // OCR confidence 0–100
  isOcrMatched         Boolean  @default(false) // OCR TID matches customer-entered TID
  flaggedSuspicious    Boolean  @default(false)

  // ── Admin Audit Trail ─────────────────────────────────────────────
  verifiedBy           String?                 // Admin email / ID
  verifiedAt           DateTime?
  rejectionReason      String?
  customerNotified     Boolean  @default(false)
  auditLogs            PaymentAuditLog[]
}

model PaymentAuditLog {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action    String   // SUBMITTED | OCR_PARSED | APPROVED | REJECTED | FLAGGED | NOTIFIED
  actor     String   // CUSTOMER | SYSTEM_OCR | ADMIN
  notes     String?
  createdAt DateTime @default(now())
}



model LensOption {
  id                     String   @id @default(uuid())
  name                   String
  description            String
  price                  Float
  pricePlus40            Float    @default(0)
  type                   String
  index                  String?
  isConfiguratorVisible  Boolean  @default(true)
  createdAt              DateTime @default(now())
}

model OrderSequence {
  id        Int      @id @default(1)
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id             String        @id @default(uuid())
  orderId        String
  productId      String
  prescriptionId String?
  price          Float
  quantity       Int           @default(1)

  framePrice         Float?
  lensBasePriceKey   String?
  lensBasePriceValue Float?
  lensMultiplier     Float?
  lensFinalPrice     Float?
  
  isAsymmetricRx     Boolean?      @default(false)
  rightEyeLensPrice  Float?
  leftEyeLensPrice   Float?
  rightMultiplier    Float?
  leftMultiplier     Float?

  selectedLensName    String?
  calculatedLensPrice Float?
  totalAmount         Float?

  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
}

model Prescription {
  id        String      @id @default(uuid())
  lensType  String
  odSph     Float
  odCyl     Float?
  odAxis    Int?
  osSph     Float
  osCyl     Float?
  osAxis    Int?
  pd        Float
  fileUrl   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt @default(now())
  OrderItem OrderItem[]
  prescription_url String?
  prescription_public_id String?
}

model LensPrice {
  id          String   @id @default(uuid())
  category    String   // "SINGLE_VISION", "BIFOCAL", "PROGRESSIVE"
  name        String   // "Anti-Glare Standard", "Blue Light Shield", "Photogray Transition"
  price       Float
  pricePlus40 Float    @default(0)
  description String?
  index       String?  // "1.56", "1.61", "1.67"
  isPopular   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  age       Int
  whatsapp  String
  frameId   String?
  status    String   @default("abandoned")
  createdAt DateTime @default(now())
}

model BasePriceSetting {
  key       String   @id
  value     Float
  updatedAt DateTime @updatedAt
}

