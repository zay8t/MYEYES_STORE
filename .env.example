# =============================================================================
# My Eyes Store — Environment Variable Reference
# Copy this file to .env.local for local development
# Set these variables in your Vercel project dashboard for production
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Required)
# -----------------------------------------------------------------------------
# Local development (PostgreSQL):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myeyes_db

# Production (Render PostgreSQL — set this in Vercel Dashboard):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# -----------------------------------------------------------------------------
# CLOUDINARY — Image CDN (Required for product image uploads)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_API_ENVIRONMENT_VARIABLE=CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# -----------------------------------------------------------------------------
# STRIPE — Payments (Required for checkout)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# NEXT.JS — App URL (Optional, used as fallback in some edge cases)
# -----------------------------------------------------------------------------
# Set this to your Vercel deployment URL in the Vercel Dashboard:
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# NOTE: All /api/* routes in this app are Next.js Route Handlers (co-located).
# They are NOT on a separate backend service.
# No NEXT_PUBLIC_API_URL rewrite is needed for standard deployment.
# If you split the backend to a separate Render service in the future, set:
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
