# =============================================================================
# MY EYES Store — Master Environment Variable Reference (.env.example)
# Copy this template to `.env.local` for local development.
# Configure these variables in your Vercel/Hosting Dashboard for production.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. DATABASE & PRISMA (Required)
# ─────────────────────────────────────────────────────────────────────────────
# Primary pooled connection URL (Prisma Accelerate or Neon Pooler)
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# Direct unpooled connection URL (Used for Prisma migrations & db push)
DIRECT_URL="postgresql://username:password@host:port/database?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────────
# 2. AUTHENTICATION & JWT SESSIONS (Required)
# ─────────────────────────────────────────────────────────────────────────────
# 256-bit secret key for signing custom session tokens (generated via `openssl rand -hex 32`)
JWT_SECRET="your-256-bit-jwt-secret-key-here"

# NextAuth configuration
NEXTAUTH_URL="https://myeyes.pk"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# Google OAuth 2.0 Credentials (for 1-click Google Sign-In)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ─────────────────────────────────────────────────────────────────────────────
# 3. SITE URL & SEO
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://myeyes.pk"

# ─────────────────────────────────────────────────────────────────────────────
# 4. CLOUDINARY — Product & Prescription Slip CDN (Required)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_API_ENVIRONMENT_VARIABLE="CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# ─────────────────────────────────────────────────────────────────────────────
# 5. GOOGLE TAG MANAGER & BOT PROTECTION
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-v3-site-key"
RECAPTCHA_SECRET_KEY="your-recaptcha-v3-secret-key"

# ─────────────────────────────────────────────────────────────────────────────
# 6. GMAIL SMTP (Transactional Order Emails)
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_USER="myeyes2026@gmail.com"
EMAIL_PASS="your-16-digit-gmail-app-password"
GMAIL_USER="myeyes2026@gmail.com"
GMAIL_APP_PASSWORD="your-16-digit-gmail-app-password"

# ─────────────────────────────────────────────────────────────────────────────
# 7. WEB PUSH NOTIFICATIONS & VAPID (Native Admin Order Alerts)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key_here"
VAPID_PRIVATE_KEY="your_vapid_private_key_here"
VAPID_SUBJECT="mailto:support@myeyes.pk"

# ─────────────────────────────────────────────────────────────────────────────
# 8. STRIPE PAYMENTS (Optional / Card Processing)
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."



