// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum FrameShape {
  NILL
  WAYFARER
  AVIATOR
  RECTANGLE
  ROUND
  OVAL
  SQUARE
  CAT_EYE
  GEOMETRIC
  RIMLESS
  SEMI_RIMLESS
}

enum Material {
  NILL
  ACETATE
  METAL
  TITANIUM
  TR90
  STAINLESS_STEEL
  WOOD
  HYBRID
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
}

enum Category {
  NILL
  EYEGLASSES
  SUNGLASSES
  CONTACT_LENSES
  ACCESSORIES
}

model Product {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String
  price       Float
  stock       Int        @default(0)
  frameShape  FrameShape @default(NILL)
  material    Material   @default(NILL)
  gender      String     @default("NILL")
  images      String
  category    Category   @default(EYEGLASSES)
  featured    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       OrderItem[]
}

model Order {
  id                  String      @id @default(uuid())
  orderNumber         String?     @unique
  customerName        String
  customerEmail       String
  customerPhone       String?
  shippingAddress     String?
  shippingCity        String?
  paymentMethod       String?
  transactionProofUrl String?
  shippingFee         Float?      @default(250)
  stripeSessionId     String?
  totalAmount         Float
  status              OrderStatus @default(PENDING)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  items               OrderItem[]
}

model LensOption {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  type        String
  index       String?
  createdAt   DateTime @default(now())
}

model OrderSequence {
  id        Int      @id @default(1)
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id             String        @id @default(uuid())
  orderId        String
  productId      String
  prescriptionId String?
  price          Float
  quantity       Int           @default(1)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
}

model Prescription {
  id        String      @id @default(uuid())
  lensType  String
  odSph     Float
  odCyl     Float?
  odAxis    Int?
  osSph     Float
  osCyl     Float?
  osAxis    Int?
  pd        Float
  fileUrl   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt @default(now())
  OrderItem OrderItem[]
}

model LensPrice {
  id          String   @id @default(uuid())
  category    String   // "SINGLE_VISION", "BIFOCAL", "PROGRESSIVE"
  name        String   // "Anti-Glare Standard", "Blue Light Shield", "Photogray Transition"
  price       Float
  description String?
  index       String?  // "1.56", "1.61", "1.67"
  isPopular   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
